<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.archflow</groupId>
    <artifactId>archflow</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>

    <name>archflow</name>
    <description>Framework open source para automação de agentes IA em Java</description>
    <!--
      Os módulos publicados declaram o próprio <url>. Por default o Maven anexa
      o diretório do módulo à url herdada, e o POM do archflow-dsl apontaria
      para github.com/edsonmartins/archflow/archflow-dsl — um 404. O atributo
      `child.project.url.inherit.append.path` existe para isso mas, ao contrário
      do equivalente no <scm> abaixo (que funciona), não surtiu efeito aqui;
      declarar explicitamente é determinístico e ainda permite apontar para o
      diretório real do módulo.
    -->
    <url>https://github.com/edsonmartins/archflow</url>

    <!--
      O domínio é o que verifica o namespace `br.com.archflow` no Central: a
      verificação é por registro TXT no DNS de archflow.com.br. É por existir
      este domínio que o groupId não precisa mudar.
    -->
    <organization>
        <name>archflow</name>
        <url>https://archflow.com.br</url>
    </organization>

    <!--
      Bloco exigido pelo Maven Central (name/description/url/licenses/developers/scm).
      Fica no pom raiz e é herdado: um módulo publicado não precisa repetir nada
      disto, e um módulo novo já nasce com os metadados certos caso venha a ser
      publicado.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>edsonmartins</id>
            <name>Edson Martins</name>
            <email>edsonmartins2005@gmail.com</email>
            <url>https://github.com/edsonmartins</url>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git@github.com:edsonmartins/archflow.git</connection>
        <developerConnection>scm:git:git@github.com:edsonmartins/archflow.git</developerConnection>
        <url>https://github.com/edsonmartins/archflow</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <langchain4j.version>1.18.0</langchain4j.version>
        <camel.version>4.3.0</camel.version>
        <spring-boot.version>4.0.6</spring-boot.version>
        <!--
          Piso de cobertura do módulo (ratchet — ver o goal `check` do jacoco).
          Default conservador; cada módulo sobe o seu no próprio pom conforme
          melhora. Não é a meta do projeto, é o chão que não se pode furar.

          0.25 e não mais: o módulo mais fraco fora de archflow-langchain4j é o
          events-proto, em 0.322. Um piso colado no valor atual dispara em
          refactor normal, e um gate que grita à toa é um gate que se aprende a
          ignorar. Os adapters do langchain4j têm piso próprio (0.15) no pom
          daquele agregador.
        -->
        <jacoco.min.coverage>0.25</jacoco.min.coverage>

        <!--
          Publicação no Maven Central: OPT-IN por módulo.

          O default é `true` (não publica) e cada módulo que deve ir para o
          Central o vira para `false` no próprio pom. A inversão é deliberada:
          com uma lista de exclusão, esquecer de acrescentar um módulo novo o
          publicaria — e publicar é irreversível, o Central não aceita remoção.
          Assim, esquecer significa "não publicou", que é o erro barato.

          Publicados hoje: archflow-model, archflow-dsl, archflow-sdk-java.
        -->
        <archflow.publish.skip>true</archflow.publish.skip>
        <!--
          Publica sozinho ao final. Para um ensaio — subir e validar sem
          publicar — use `-Darchflow.publish.auto=false -Darchflow.publish.waitUntil=validated`
          e conclua manualmente em central.sonatype.com/publishing/deployments.
        -->
        <archflow.publish.auto>true</archflow.publish.auto>
        <archflow.publish.waitUntil>published</archflow.publish.waitUntil>
        <maven.source.plugin.version>3.3.0</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.6.3</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.7</maven.gpg.plugin.version>
        <central.publishing.plugin.version>0.10.0</central.publishing.plugin.version>
        <flatten.plugin.version>1.6.0</flatten.plugin.version>
    </properties>

    <modules>
        <module>archflow-core</module>
        <module>archflow-model</module>
        <module>archflow-security</module>
        <module>archflow-observability</module>
        <module>archflow-templates</module>
        <module>archflow-conversation</module>
        <module>archflow-marketplace</module>
        <module>archflow-workflow-tool</module>
        <module>archflow-performance</module>
        <module>archflow-plugin-api</module>
        <module>archflow-plugins</module>
        <module>archflow-api</module>
        <module>archflow-agent</module>
        <module>archflow-langchain4j</module>
        <module>archflow-plugin-loader</module>
        <module>archflow-brainsentry</module>
        <module>archflow-events-proto</module>
        <module>archflow-standalone</module>
        <module>archflow-dsl</module>
        <module>archflow-sdk-java</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- Apache Camel BOM -->
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- LangChain4j BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM (testes de integração com Postgres real) -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <optional>true</optional>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Compilação -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <target>${maven.compiler.target}</target>
                        <source>${maven.compiler.source}</source>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.40</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Source -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                            <configuration>
                                <classifier>sources</classifier>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- JavaDoc -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <source>${java.version}</source>
                        <encoding>UTF-8</encoding>
                        <failOnError>false</failOnError>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>

                <!-- Jacoco -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.13</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!--
                          Gate de RATCHET, não de aspiração.

                          Não havia goal `check` nenhum: a documentação falava em
                          "mínimo 80%" e o build não verificava nada. Fixar 80%
                          agora quebraria o build na hora — a cobertura real vai
                          de ~38% a ~98% dependendo do módulo.

                          O piso é por módulo (`jacoco.min.coverage`), começa
                          ABAIXO do que cada um já tem e existe para impedir
                          REGRESSÃO, não para premiar. Subir um piso é uma
                          alteração de uma linha no pom do módulo, e é assim que
                          a cobertura avança de verdade.
                        -->
                        <execution>
                            <id>check</id>
                            <phase>test</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.min.coverage}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Publicação no Maven Central (Sonatype Central Portal).

              mvn clean deploy -Pmaven-central -DskipTests -s .maven-settings.xml.template

          Requer credenciais do servidor `central` e uma chave GPG. Ver RELEASING.md.

          Só os módulos com `archflow.publish.skip=false` sobem — ver a nota na
          propriedade lá em cima. O workflow de release ainda restringe o reator
          com `-pl`, então há duas barreiras independentes: se uma falhar, a
          outra ainda impede uma publicação acidental.
        -->
        <profile>
            <id>maven-central</id>
            <build>
                <plugins>
                    <!--
                      Sources e javadoc são obrigatórios no Central. Declarados
                      sem <executions> de propósito: as execuções já estão no
                      pluginManagement do build acima (`attach-sources`,
                      `attach-javadocs`), e repeti-las aqui anexaria o jar duas
                      vezes.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.plugin.version}</version>
                    </plugin>

                    <!-- Assinatura GPG, também obrigatória. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                      O POM que vai para o Central é o pom.xml CRU do módulo, não
                      o efetivo. Como a raiz do reator não é publicada (só 3 dos
                      38 módulos vão), o <parent> que esses poms declaram não
                      existe no Central — e sem ele nada é herdado. A primeira
                      tentativa de publicar foi rejeitada exatamente assim, nos
                      três artefatos:

                        License information is missing
                        SCM URL is not defined
                        Developers information is missing
                        Dependency version information is missing for: langchain4j,
                        commons-lang3, junit-jupiter, mockito, assertj

                      Nada disso faltava no pom — faltava o parent de onde vinham.

                      O flatten resolve na origem certa: publica um POM sem
                      <parent>, com as versões já resolvidas e com
                      licenses/scm/developers/url/description embutidos. O modo
                      `ossrh` é o que existe para este caso.

                      A alternativa seria publicar a raiz do reator junto, mas ela
                      importa 4 BOMs (Spring Boot, Camel, LangChain4j,
                      Testcontainers) no dependencyManagement — quem dependesse do
                      archflow-dsl herdaria todos.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>${flatten.plugin.version}</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                              Via propriedade, e não literal: uma <configuration>
                              fixa vence o -D da linha de comando, e aí não
                              haveria como fazer um ensaio. Com a propriedade,
                              `-Darchflow.publish.auto=false` sobe e valida o
                              bundle mas deixa a publicação para um clique no
                              portal — o que se quer numa primeira vez, já que o
                              Central não aceita remover uma versão publicada.
                            -->
                            <autoPublish>${archflow.publish.auto}</autoPublish>
                            <waitUntil>${archflow.publish.waitUntil}</waitUntil>
                            <skipPublishing>${archflow.publish.skip}</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>